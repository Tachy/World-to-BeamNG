# Base data files (height/DGM1, satellite/DOP20, buildings/LoD2) - contents ignored, but each
# folder's own README.md (checked in, explains what belongs there) stays tracked
data/height/*
!data/height/README.md
data/satellite/*
!data/satellite/README.md
data/buildings/*
!data/buildings/README.md
data/assets
data/italy
# Beliebige Backup-/Alternativ-Varianten der drei Ordner (z.B. _ch, _lgl, _bak, ...) - egal welches
# Suffix als naechstes dazukommt, nie versehentlich einchecken.
data/height_*
data/satellite_*
data/buildings_*

# Cache files
cache/
debug/
bin/

# Vorlage BeamNG
levels/

# Python
__pycache__/
*.py[cod]
*$py.class
*.backup
.venv/
venv/

# Output files
*.obj
*.mtl
*.zip
*.tar.gz
*.log
*.exe


# IDE
.vscode/
.idea/
*.code-workspace

# Documentation (internal only)
REFACTORING.md
report.html
tools/level_viewer.cfg

# Subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/
