# .claudeignore — keep context tokens for source/docs, exclude bulky/generated data.
# This is separate from .gitignore: some git-tracked files (report.html, .venv) also
# don't need to be read by the assistant, and some git-ignored dirs are listed here
# again for clarity/completeness.

# Raw geodata (height/imagery/building tiles) — huge, binary, never worth reading
# (each folder's own README.md is tiny and worth reading, so it's excepted)
data/height/*
!data/height/README.md
data/satellite/*
!data/satellite/README.md
data/buildings/*
!data/buildings/README.md
data/height_*/
data/satellite_*/
data/buildings_*/
data/assets/
data/italy/
data/*.jpg
data/*.jpeg
data/*.png

# Generated/cache output
cache/
debug/
levels/
*.obj
*.mtl
*.dae

# Python environment & bytecode
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Git internals
.git/

# Vendored binaries
bin/*.exe

# Large generated reports
report.html

# Archives / logs
*.zip
*.tar.gz
*.log

# Editor/IDE
.vscode/
.idea/
*.code-workspace

# Subagent-driven-development scratch workspace
.superpowers/
